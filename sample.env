# Telegram configs
BOT_NAME=Torrent Hunt Clone
BOT_TOKEN=
API_ID=
API_HASH=
BOT_ADMINS=

# Database connection string
DATABASE_URL=sqlite:///torrenthunt.db

# Torrent search provider (currently supported: jackett, prowlarr)
TORRENT_PROVIDER=jackett

# Jackett configuration (if using jackett)
JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=

# Prowlarr configuration (if using prowlarr)
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# Tag-based indexer filtering (leave empty to search all indexers)
# Assign these tags to indexers in Jackett/Prowlarr to control which
# indexers are used for message search vs inline search.
# MESSAGE_SEARCH_TAG=torrenthunt-message
# INLINE_SEARCH_TAG=torrenthunt-inline

# Optional: query a single Jackett indexer instead of all configured ones
# JACKETT_INDEXER=all
# Optional: request timeout in seconds
# JACKETT_TIMEOUT=40
# Optional: days a cached result stays resolvable via /getLink (default 90)
# TORRENT_CACHE_DAYS=90
# Optional: how often background cleanup jobs run (default 60 minutes)
# CLEANUP_INTERVAL_MINUTES=60

# Message to forward on start
START_ADS=false
START_ADS_CHANNEL=
START_ADS_MESSAGE=

# Sentry.io for error tracing
SENTRY_DSN=

ENVIRONMENT=local
